# Dotfiles / local tooling
.*
!.gitignore
!.env.template
!**/.gitkeep
*.egg-info/

# Local reference tree (full prior clone)
_*/

# Private notes
/notes/

# Python / tooling
__pycache__/
*.pyc
.ipynb_checkpoints/
dist/
build/
.venv/
.pytest_cache/

# Credentials and secrets
.env
.env.*
!.env.template
credentials.json
secrets.json
*.pem
*.key
pgpass*
.pgpass

# Licensed / generated market data (keep directory placeholders only)
/data/**
!/data/**/
!/data/**/.gitkeep

# Stage outputs (keep directory placeholders)
/output/**
!/output/**/
!/output/**/.gitkeep

# Large binary caches
*.parquet
*.pkl
*.pickle
*.h5
*.feather
