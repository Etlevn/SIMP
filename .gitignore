# Dotfiles / local tooling (.* covers .cursor/ — do not force-add)
.*
!.gitignore
!.env.template
!**/.gitkeep
*.egg-info/

# Local reference tree (full prior clone)
_*/

# Private notes
/notes/

# Local agent plans / specs
/docs/superpowers/

# Python / tooling
__pycache__/
*.pyc
.ipynb_checkpoints/
dist/
build/
.venv/
.pytest_cache/

# Credentials and secrets
.env
.env.*
!.env.template
credentials.json
secrets.json
*.pem
*.key
pgpass*
.pgpass

# Licensed / generated market data (keep directory placeholders only)
/data/**
!/data/**/
!/data/**/.gitkeep

# Stage outputs (entire tree local-only; including empty dirs)
/output/

# Large binary caches
*.parquet
*.pkl
*.pickle
*.h5
*.feather
